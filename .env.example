# ─────────────────────────────────────────────────────────────
#  Cabas — configuration. Copiez ce fichier en .env puis adaptez.
# ─────────────────────────────────────────────────────────────

# Application
APP_NAME=Cabas
# Adresse publique de l'app (sert aux liens d'invitation ; https active les cookies sécurisés)
APP_URL=https://courses.mondomaine.fr
PORT=3000
NODE_ENV=production
# Secret des sessions : 32 caractères minimum. Générez-en un avec : openssl rand -hex 32
SESSION_SECRET=change-me-par-une-longue-chaine-aleatoire-de-32-caracteres
TZ=Europe/Paris
# Langue par défaut de l'interface : fr ou en
DEFAULT_LOCALE=fr
CURRENCY=EUR

# Base de données
# - base embarquée (docker compose --profile db up -d) : gardez l'hôte « postgres »
# - base externe : mettez son adresse, ex. postgresql://user:mdp@db.mondomaine.fr:5432/cabas
DATABASE_URL=postgresql://cabas:cabas@postgres:5432/cabas
# Utilisés uniquement par le service « postgres » embarqué
POSTGRES_USER=cabas
POSTGRES_PASSWORD=cabas
POSTGRES_DB=cabas

# Premier administrateur (créé au premier démarrage si la base est vide)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Nom de son foyer
ADMIN_HOUSEHOLD=Ma famille

# Inscription publique (false = seuls les parents créent les comptes ou envoient des invitations)
ALLOW_SIGNUP=false

# Webhook d'import de tickets (n8n). Chaque foyer peut aussi générer son propre token dans Réglages › Foyer.
WEBHOOK_TOKEN=change-me-long-token-aleatoire

# Open Food Facts (aucune clé requise, mais un user-agent identifiable est demandé)
OFF_USER_AGENT=Cabas/1.0 (contact@example.com)

# OCR des tickets photo / PDF scannés : tesseract (embarqué) ou none
OCR_PROVIDER=tesseract

# Taille maximale d'un ticket envoyé (Mo)
MAX_UPLOAD_MB=15

# Données de démonstration (famille fictive) : true pour les créer au démarrage
SEED_DEMO=false

# Niveau de logs : fatal, error, warn, info, debug
LOG_LEVEL=info
